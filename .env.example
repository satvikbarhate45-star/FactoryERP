# ==============================================================================
# PharmaERP Environment Configuration Template (.env)
# ==============================================================================

# Django Secret Key and Debug Settings
SECRET_KEY=django-insecure-pharma-erp-production-key-change-me
DEBUG=True

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
#
# Supabase Transaction Pooler (Recommended for IPv4 / Cloud):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Supabase Session Pooler (Alternative port 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct Database Connection:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# ------------------------------------------------------------------------------
# AI Chat / Gemini API
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
