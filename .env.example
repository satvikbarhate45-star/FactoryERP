# ==============================================================================
# PharmaERP Environment Configuration Template (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
SECRET_KEY=your-secure-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
#
# Supabase Transaction Pooler (Recommended for Render / Cloud IPv4):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Supabase Session Pooler (Alternative port 5432):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Hugging Face ML Pipeline & Inference API
# ------------------------------------------------------------------------------
# Can be provided as HUGGINGFACE_API_KEY or HF_TOKEN
HUGGINGFACE_API_KEY=hf_your_huggingface_api_token_here
# HF_TOKEN=hf_your_huggingface_api_token_here

# ------------------------------------------------------------------------------
# Google Gemini AI Assistant & Audio TTS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
